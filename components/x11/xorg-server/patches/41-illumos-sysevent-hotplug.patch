+#ifdef __sun
+/* libsysevent delivers on its own thread. Only the pipe crosses into Xorg;
+ * its callback never accesses RandR, DRM, ScrnInfo or output objects. */
+#include <libsysevent.h>
+#include <sys/nvpair.h>
+#include <sys/mkdev.h>
+#include <pthread.h>
+#include <fcntl.h>
+
+struct drmmode_sysevent {
+    struct drmmode_sysevent *next;
+    drmmode_ptr drmmode;
+    uint32_t major, minor;
+    int pipefd[2];
+    InputHandlerProc handler;
+    OsTimerPtr timer;
+};
+static pthread_mutex_t sysevent_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct drmmode_sysevent *sysevent_screens;
+static sysevent_handle_t *sysevent_handle;
+
+static void
+drmmode_sysevent_callback(sysevent_t *ev)
+{
+    nvlist_t *attrs;
+    uint32_t version, driver_major, primary_minor;
+    struct drmmode_sysevent *s;
+    const char byte = 1;
+
+    if (strcmp(sysevent_get_class_name(ev), "EC_drm") ||
+        strcmp(sysevent_get_subclass_name(ev), "ESC_drm_hotplug") ||
+        sysevent_get_attr_list(ev, &attrs) != 0)
+        return;
+    if (nvlist_lookup_uint32(attrs, "version", &version) == 0 && version == 1 &&
+        nvlist_lookup_uint32(attrs, "driver-major", &driver_major) == 0 &&
+        nvlist_lookup_uint32(attrs, "primary-minor", &primary_minor) == 0) {
+        pthread_mutex_lock(&sysevent_lock);
+        for (s = sysevent_screens; s; s = s->next) {
+            if (s->major == driver_major && s->minor == primary_minor) {
+                ssize_t n;
+                do { n = write(s->pipefd[1], &byte, 1); } while (n < 0 && errno == EINTR);
+                /* EAGAIN means a notification is already pending. */
+            }
+        }
+        pthread_mutex_unlock(&sysevent_lock);
+    }
+    nvlist_free(attrs);
+}
+
+static CARD32
+drmmode_sysevent_reprobe(OsTimerPtr timer, CARD32 now, void *closure)
+{
+    struct drmmode_sysevent *s = closure;
+    if (!s->drmmode->scrn->vtSema)
+        return 1000; /* Keep the last event until this screen owns the VT. */
+    drmmode_update_kms_state(s->drmmode);
+    return 0;
+}
+
+static void
+drmmode_sysevent_read(int fd, void *closure)
+{
+    struct drmmode_sysevent *s = closure;
+    char bytes[256];
+    ssize_t n;
+    do { n = read(fd, bytes, sizeof(bytes)); } while (n > 0 || (n < 0 && errno == EINTR));
+    /* TimerSet coalesces bursts; the kernel also bounds event frequency. */
+    s->timer = TimerSet(s->timer, 0, 100, drmmode_sysevent_reprobe, s);
+}
+
+static void
+drmmode_sysevent_init(drmmode_ptr drmmode)
+{
+    struct drmmode_sysevent *s;
+    struct stat st;
+    const char *subclass = "ESC_drm_hotplug";
+    drmVersionPtr ver;
+    int i;
+
+    if (fstat(drmmode->fd, &st) != 0)
+        return;
+    /* Facade 2.0 clone opens encode the node in the low nine minor bits.
+     * Do not interpret an unrelated driver's clone ABI this way. */
+    ver = drmGetVersion(drmmode->fd);
+    if (!ver)
+        return;
+    i = !strcmp(ver->name, "i915") || !strcmp(ver->name, "virtio_gpu");
+    drmFreeVersion(ver);
+    if (!i || (minor(st.st_rdev) & 0x1ff) >= 128)
+        return;
+    s = calloc(1, sizeof(*s));
+    if (!s)
+        return;
+    if (pipe(s->pipefd) != 0) {
+        free(s);
+        return;
+    }
+    for (i = 0; i < 2; i++) {
+        if (fcntl(s->pipefd[i], F_SETFL, O_NONBLOCK) < 0 ||
+            fcntl(s->pipefd[i], F_SETFD, FD_CLOEXEC) < 0)
+            goto fail;
+    }
+    if (!sysevent_handle) {
+        sysevent_handle = sysevent_bind_handle(drmmode_sysevent_callback);
+        if (!sysevent_handle)
+            goto fail;
+        if (sysevent_subscribe_event(sysevent_handle, "EC_drm", &subclass, 1) != 0) {
+            sysevent_unbind_handle(sysevent_handle);
+            sysevent_handle = NULL;
+            goto fail;
+        }
+    }
+    s->drmmode = drmmode;
+    s->major = major(st.st_rdev);
+    s->minor = minor(st.st_rdev) & 0x1ff;
+    s->handler = xf86AddGeneralHandler(s->pipefd[0], drmmode_sysevent_read, s);
+    if (!s->handler)
+        goto fail;
+    pthread_mutex_lock(&sysevent_lock);
+    s->next = sysevent_screens;
+    sysevent_screens = s;
+    pthread_mutex_unlock(&sysevent_lock);
+    drmmode->sysevent = s;
+    /* Close the subscription race with a complete initial reprobe. */
+    s->timer = TimerSet(NULL, 0, 100, drmmode_sysevent_reprobe, s);
+    xf86DrvMsg(drmmode->scrn->scrnIndex, X_INFO, "illumos DRM sysevent hotplug enabled\n");
+    return;
+fail:
+    if (!sysevent_screens && sysevent_handle) {
+        sysevent_unbind_handle(sysevent_handle);
+        sysevent_handle = NULL;
+    }
+    close(s->pipefd[0]);
+    close(s->pipefd[1]);
+    free(s);
+    xf86DrvMsg(drmmode->scrn->scrnIndex, X_WARNING, "illumos DRM sysevent hotplug unavailable\n");
+}
+
+static void
+drmmode_sysevent_fini(drmmode_ptr drmmode)
+{
+    struct drmmode_sysevent *s = drmmode->sysevent, **p;
+    if (!s)
+        return;
+    pthread_mutex_lock(&sysevent_lock);
+    for (p = &sysevent_screens; *p && *p != s; p = &(*p)->next) {}
