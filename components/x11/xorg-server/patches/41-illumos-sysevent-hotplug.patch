+    if (!sysevent_screens) {
+        sysevent_unbind_handle(sysevent_handle);
+        sysevent_handle = NULL;
+    }
+    xf86RemoveGeneralHandler(s->handler);
+    TimerFree(s->timer);
+    close(s->pipefd[0]);
+    close(s->pipefd[1]);
+    drmmode->sysevent = NULL;
+    free(s);
+}
